# 本地 Postgres（docker compose 默认）
DATABASE_URL=postgres://envvault:envvault@localhost:5432/envvault
# neon 连接串含 neon.tech 时自动走 Neon HTTP 驱动；也可显式指定 pg 或 neon
DB_DRIVER=pg

# 可选。不配置则 AI 按钮不可用，内置模板仍可用。不要把真实密钥写进仓库。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
